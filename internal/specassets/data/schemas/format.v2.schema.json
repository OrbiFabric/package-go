{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbifabric.org/package/schemas/format.v2.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orbifabric.package.format.v2"
    },
    "protocol": {
      "const": "orbifabric.package"
    },
    "protocol_version": {
      "const": "2.0"
    },
    "tree_profile": {
      "const": "orbifabric.package-tree.v1"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "uniqueItems": true
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "required_capability": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "namespace",
          "required_capability"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "protocol",
    "protocol_version",
    "tree_profile",
    "profiles",
    "required_capabilities",
    "optional_capabilities",
    "extensions"
  ],
  "additionalProperties": false
}
