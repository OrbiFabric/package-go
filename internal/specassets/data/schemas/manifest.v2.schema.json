{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbifabric.org/package/schemas/manifest.v2.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orbifabric.package.manifest.v2"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "package_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "file"
              },
              "file_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "parent_folder_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$"
              },
              "content_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "file_id",
              "parent_folder_id",
              "name",
              "content_id",
              "size"
            ],
            "additionalProperties": true,
            "not": {
              "required": [
                "folder_id"
              ]
            }
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "folder"
              },
              "folder_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "parent_folder_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$"
              }
            },
            "required": [
              "kind",
              "folder_id",
              "parent_folder_id",
              "name"
            ],
            "additionalProperties": true,
            "not": {
              "anyOf": [
                {
                  "required": [
                    "file_id"
                  ]
                },
                {
                  "required": [
                    "content_id"
                  ]
                },
                {
                  "required": [
                    "size"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "package_id",
    "package_version_id",
    "entries"
  ],
  "additionalProperties": true
}
