{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbifabric.org/package/schemas/metadata.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orbifabric.package.metadata.v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "package_id",
    "title"
  ],
  "additionalProperties": true
}
